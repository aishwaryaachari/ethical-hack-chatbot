# Core API Service Configuration
API_PORT=8000
ENVIRONMENT=development

# Large Language Model Provider (Groq Cloud)
# Obtain a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_demo_placeholder_token_abc123
